# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DATABASE_URL: Neon PostgreSQL connection string for user accounts and persistent data.
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google AdSense Monetization Config (Optional)
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_ENABLED=
NEXT_PUBLIC_AD_SLOT_HOME_MIDDLE=
NEXT_PUBLIC_AD_SLOT_TOOL_BELOW=
NEXT_PUBLIC_AD_SLOT_TOOL_BOTTOM=
NEXT_PUBLIC_AD_SLOT_CATEGORY_BOTTOM=
NEXT_PUBLIC_AD_SLOT_BLOG_MID=
NEXT_PUBLIC_AD_SLOT_BLOG_BOTTOM=
